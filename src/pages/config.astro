---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="WebHID コンフィギュレータ — ZENAIM KEYBOARD"
  description="Read and write actuation points, lighting and LED settings on the ZENAIM KEYBOARD from your browser over WebHID."
  active="config"
>
  <section class="config-hero">
    <div>
      <p class="eyebrow" data-i18n="config.eyebrow"></p>
      <h1 data-i18n="config.title"></h1>
      <p class="config-lead" data-i18n="config.lead"></p>
    </div>
    <span class="config-chip"><span class="live-dot"></span><span data-i18n="config.local"></span></span>
  </section>
  <div id="config-root"></div>
  <div id="overlay-slot"></div>
</BaseLayout>

<script>
  import '../scripts/config-app';
</script>
