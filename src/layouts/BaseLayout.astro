---
import { url } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'config';
}

const { title, description, active } = Astro.props;
const homeHref = url();
const configHref = url('config.html');
const docsHref = 'https://github.com/nananek/unofficial-zenaim-util/blob/main/docs/protocol.md';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="color-scheme" content="dark light" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={homeHref}>
          <span class="brand-mark" aria-hidden="true">Z</span>
          <span class="brand-text">
            <strong>ZENAIM KEYBOARD</strong>
            <small data-i18n="app.tagline"></small>
          </span>
        </a>
        <nav class="site-nav">
          <a href={homeHref} class:list={['nav-link', active === 'home' && 'is-active']} data-i18n="nav.home"></a>
          <a href={configHref} class:list={['nav-link', active === 'config' && 'is-active']} data-i18n="nav.config"></a>
          <a class="nav-link" href={docsHref} rel="noopener" data-i18n="nav.docs"></a>
          <div class="lang-switch" role="group" aria-label="Language">
            <button type="button" data-lang-option="ja" data-i18n="app.lang.ja"></button>
            <button type="button" data-lang-option="en" data-i18n="app.lang.en"></button>
          </div>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer container">
      <p data-i18n="app.disclaimer"></p>
      <p>
        <a href={docsHref} rel="noopener">docs/protocol.md</a> ·
        MIT License
      </p>
    </footer>

    <script>
      import { getLang, setLang, onLangChange } from '../lib/ui/i18n';

      function syncLangButtons(): void {
        const lang = getLang();
        document.querySelectorAll<HTMLButtonElement>('[data-lang-option]').forEach((button) => {
          const isActive = button.dataset.langOption === lang;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', String(isActive));
        });
      }

      document.querySelectorAll<HTMLButtonElement>('[data-lang-option]').forEach((button) => {
        button.addEventListener('click', () => setLang(button.dataset.langOption === 'en' ? 'en' : 'ja'));
      });
      onLangChange(syncLangButtons);
      syncLangButtons();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0f1115;
    --panel: #171a21;
    --panel-2: #1d2129;
    --border: #2a2f3a;
    --text: #e6e8ee;
    --muted: #98a2b3;
    --accent: #4c8dff;
    --accent-soft: rgba(76, 141, 255, 0.14);
    --ok: #37b26b;
    --warn: #d99a2b;
    --error: #e05656;
    --radius: 10px;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  @media (prefers-color-scheme: light) {
    :root {
      --bg: #f6f7f9;
      --panel: #ffffff;
      --panel-2: #f0f2f5;
      --border: #d8dde5;
      --text: #1b1f27;
      --muted: #5b6472;
      --accent-soft: rgba(76, 141, 255, 0.12);
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    line-height: 1.6;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    padding: 2rem 0 3rem;
  }

  .container {
    width: min(1100px, 100% - 2rem);
    margin-inline: auto;
  }

  a {
    color: var(--accent);
  }

  h1,
  h2,
  h3 {
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }

  h1 {
    font-size: clamp(1.6rem, 1.1rem + 2vw, 2.4rem);
  }

  h2 {
    font-size: 1.25rem;
    margin-top: 2rem;
  }

  p {
    margin: 0 0 1rem;
  }

  code,
  .mono {
    font-family: var(--mono);
    font-size: 0.9em;
  }

  /* ------------------------------------------------------------- header */

  .site-header {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--panel) 88%, transparent);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: inherit;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand-text small {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .nav-link {
    padding: 0.35rem 0.6rem;
    border-radius: 8px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--panel-2);
  }

  .nav-link.is-active {
    color: var(--text);
    background: var(--accent-soft);
  }

  .lang-switch {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
    margin-left: 0.5rem;
  }

  .lang-switch button {
    border: 0;
    background: transparent;
    color: var(--muted);
    padding: 0.3rem 0.7rem;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .lang-switch button.is-active {
    background: var(--accent);
    color: #fff;
  }

  /* --------------------------------------------------------------- cards */

  .card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    margin-bottom: 1rem;
  }

  .card > :last-child {
    margin-bottom: 0;
  }

  .grid {
    display: grid;
    gap: 1rem;
  }

  .grid.cols-2 {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .grid.cols-3 {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  /* ------------------------------------------------------------- buttons */

  button,
  .button {
    font: inherit;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--panel-2);
    color: var(--text);
    padding: 0.5rem 0.9rem;
    cursor: pointer;
  }

  button:hover:not(:disabled),
  .button:hover {
    border-color: var(--accent);
  }

  button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .button.primary,
  button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 600;
  }

  .button.primary:hover,
  button.primary:hover:not(:disabled) {
    filter: brightness(1.08);
  }

  .button-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  /* ---------------------------------------------------------------- forms */

  select,
  input[type="number"],
  input[type="text"],
  input[type="color"] {
    font: inherit;
    color: var(--text);
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.35rem 0.5rem;
  }

  input[type="color"] {
    padding: 0.15rem;
    width: 3rem;
    height: 2rem;
  }

  input[type="range"] {
    width: 100%;
    accent-color: var(--accent);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 0.9rem;
  }

  .field > label {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .field-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  /* ---------------------------------------------------------------- tables */

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  th {
    color: var(--muted);
    font-weight: 500;
    width: 42%;
  }

  /* ---------------------------------------------------------------- status */

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--panel-2);
  }

  .status::before {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--muted);
  }

  .status.is-connected::before {
    background: var(--ok);
  }

  .status.is-demo::before {
    background: var(--accent);
  }

  .status.is-connecting::before {
    background: var(--warn);
  }

  .status.is-error::before {
    background: var(--error);
  }

  .notice {
    border-radius: 8px;
    padding: 0.6rem 0.8rem;
    margin: 0.75rem 0;
    border: 1px solid var(--border);
    background: var(--panel-2);
    font-size: 0.9rem;
  }

  .notice.ok {
    border-color: color-mix(in srgb, var(--ok) 50%, var(--border));
  }

  .notice.warn {
    border-color: color-mix(in srgb, var(--warn) 50%, var(--border));
  }

  .notice.error {
    border-color: color-mix(in srgb, var(--error) 50%, var(--border));
  }

  .muted {
    color: var(--muted);
  }

  .small {
    font-size: 0.85rem;
  }

  /* ----------------------------------------------------------------- tabs */

  .tabs {
    display: flex;
    gap: 0.25rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1rem;
    overflow-x: auto;
  }

  .tabs button {
    border: 0;
    background: transparent;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    color: var(--muted);
    padding: 0.6rem 0.9rem;
    white-space: nowrap;
  }

  .tabs button.is-active {
    color: var(--text);
    border-bottom-color: var(--accent);
  }

  /* ------------------------------------------------------------ key grid */

  .key-grid {
    display: grid;
    gap: 4px;
    margin-top: 0.5rem;
  }

  .key-cell {
    aspect-ratio: 1 / 1;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0;
    font-size: 0.65rem;
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .key-cell.is-selected {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0 2rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .badge {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    color: var(--muted);
  }

  .busy-overlay {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    display: grid;
    place-items: center;
    z-index: 50;
    font-size: 0.95rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .busy-overlay span {
      animation: pulse 1.2s ease-in-out infinite;
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0.45;
    }
  }
</style>
