---
import { url } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'config';
}

const { title, description, active } = Astro.props;
const homeHref = url();
const configHref = url('config.html');
const docsHref = 'https://github.com/nananek/unofficial-zenaim-util/blob/main/docs/protocol.md';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="color-scheme" content="dark light" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={homeHref}>
          <span class="brand-mark" aria-hidden="true">Z</span>
          <span class="brand-text">
            <strong>ZENAIM KEYBOARD</strong>
            <small data-i18n="app.tagline"></small>
          </span>
        </a>
        <nav class="site-nav">
          <a href={homeHref} class:list={['nav-link', active === 'home' && 'is-active']} data-i18n="nav.home"></a>
          <a href={configHref} class:list={['nav-link', active === 'config' && 'is-active']} data-i18n="nav.config"></a>
          <a class="nav-link" href={docsHref} rel="noopener" data-i18n="nav.docs"></a>
          <div class="lang-switch" role="group" aria-label="Language">
            <button type="button" data-lang-option="ja" data-i18n="app.lang.ja"></button>
            <button type="button" data-lang-option="en" data-i18n="app.lang.en"></button>
          </div>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer container">
      <p data-i18n="app.disclaimer"></p>
      <p>
        <a href={docsHref} rel="noopener">docs/protocol.md</a> ·
        MIT License
      </p>
    </footer>

    <script>
      import { getLang, setLang, onLangChange } from '../lib/ui/i18n';

      function syncLangButtons(): void {
        const lang = getLang();
        document.querySelectorAll<HTMLButtonElement>('[data-lang-option]').forEach((button) => {
          const isActive = button.dataset.langOption === lang;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', String(isActive));
        });
      }

      document.querySelectorAll<HTMLButtonElement>('[data-lang-option]').forEach((button) => {
        button.addEventListener('click', () => setLang(button.dataset.langOption === 'en' ? 'en' : 'ja'));
      });
      onLangChange(syncLangButtons);
      syncLangButtons();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0a0d0c;
    --panel: #111715;
    --panel-2: #18211d;
    --border: #28362f;
    --text: #f0f4ef;
    --muted: #98a69e;
    --accent: #b8f36b;
    --accent-soft: rgba(184, 243, 107, 0.12);
    --ok: #66d79a;
    --warn: #e7b85e;
    --error: #ee7777;
    --radius: 14px;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color-scheme: dark;
  }

  @media (prefers-color-scheme: light) {
    :root {
      --bg: #f4f6f2;
      --panel: #fff;
      --panel-2: #edf2eb;
      --border: #d8e0d8;
      --text: #1b241e;
      --muted: #68766d;
      --accent: #416d16;
      --accent-soft: rgba(65, 109, 22, 0.1);
      color-scheme: light;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    line-height: 1.55;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    padding: 2.6rem 0 4rem;
  }

  .container {
    width: min(1200px, 100% - 2.5rem);
    margin-inline: auto;
  }

  a {
    color: var(--accent);
  }

  h1,
  h2,
  h3 {
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }

  h1 {
    font-size: clamp(1.6rem, 1.1rem + 2vw, 2.4rem);
  }

  h2 {
    font-size: 1.25rem;
    margin-top: 2rem;
  }

  p {
    margin: 0 0 1rem;
  }

  code,
  .mono {
    font-family: var(--mono);
    font-size: 0.9em;
  }

  /* ------------------------------------------------------------- header */

  .site-header {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: blur(16px);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: inherit;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 10px;
    background: var(--accent);
    color: #10170c;
    font-weight: 700;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand-text small {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .nav-link {
    padding: 0.35rem 0.6rem;
    border-radius: 8px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--panel-2);
  }

  .nav-link.is-active {
    color: var(--text);
    background: var(--accent-soft);
  }

  .lang-switch {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
    margin-left: 0.5rem;
  }

  .lang-switch button {
    border: 0;
    background: transparent;
    color: var(--muted);
    padding: 0.3rem 0.7rem;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .lang-switch button.is-active {
    background: var(--accent);
    color: #fff;
  }

  /* --------------------------------------------------------------- cards */

  .card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    margin-bottom: 1rem;
  }

  .card > :last-child {
    margin-bottom: 0;
  }

  .grid {
    display: grid;
    gap: 1rem;
  }

  .grid.cols-2 {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .grid.cols-3 {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  /* ------------------------------------------------------------- buttons */

  button,
  .button {
    font: inherit;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--panel-2);
    color: var(--text);
    padding: 0.5rem 0.9rem;
    cursor: pointer;
  }

  button:hover:not(:disabled),
  .button:hover {
    border-color: var(--accent);
  }

  button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  button:focus-visible,
  a:focus-visible,
  select:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .button.primary,
  button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #11170d;
    font-weight: 600;
  }

  .button.primary:hover,
  button.primary:hover:not(:disabled) {
    filter: brightness(1.08);
  }

  .button-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  /* ---------------------------------------------------------------- forms */

  select,
  input[type="number"],
  input[type="text"],
  input[type="color"] {
    font: inherit;
    color: var(--text);
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.35rem 0.5rem;
  }

  input[type="color"] {
    padding: 0.15rem;
    width: 3rem;
    height: 2rem;
  }

  input[type="range"] {
    width: 100%;
    accent-color: var(--accent);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 0.9rem;
  }

  .field > label {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .field-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  /* ---------------------------------------------------------------- tables */

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  th {
    color: var(--muted);
    font-weight: 500;
    width: 42%;
  }

  /* ---------------------------------------------------------------- status */

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--panel-2);
  }

  .status::before {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--muted);
  }

  .status.is-connected::before {
    background: var(--ok);
  }

  .status.is-demo::before {
    background: var(--accent);
  }

  .status.is-connecting::before {
    background: var(--warn);
  }

  .status.is-error::before {
    background: var(--error);
  }

  .notice {
    border-radius: 8px;
    padding: 0.6rem 0.8rem;
    margin: 0.75rem 0;
    border: 1px solid var(--border);
    background: var(--panel-2);
    font-size: 0.9rem;
  }

  .notice.ok {
    border-color: color-mix(in srgb, var(--ok) 50%, var(--border));
  }

  .notice.warn {
    border-color: color-mix(in srgb, var(--warn) 50%, var(--border));
  }

  .notice.error {
    border-color: color-mix(in srgb, var(--error) 50%, var(--border));
  }

  .muted {
    color: var(--muted);
  }

  .small {
    font-size: 0.85rem;
  }

  /* ----------------------------------------------------------------- tabs */

  .tabs {
    display: flex;
    gap: 0.25rem;
    width: fit-content;
    max-width: 100%;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.25rem;
    margin-bottom: 1.25rem;
    overflow-x: auto;
    background: var(--panel);
  }

  .tabs button {
    border: 0;
    background: transparent;
    border-radius: 8px;
    color: var(--muted);
    padding: 0.5rem 0.9rem;
    white-space: nowrap;
  }

  .tabs button.is-active {
    color: var(--text);
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 36%, transparent);
  }

  /* ------------------------------------------------------------ key grid */

  .key-grid {
    display: grid;
    gap: 5px;
    margin-top: 1rem;
    padding: 1rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--bg) 65%, var(--panel));
    border: 1px solid var(--border);
  }

  .key-cell {
    position: relative;
    aspect-ratio: 1.15 / 1;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 7px;
    padding: 0;
    font-size: clamp(0.5rem, 0.75vw, 0.7rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .key-cell.is-selected {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    z-index: 1;
    transform: translateY(-2px);
    box-shadow: 0 5px 16px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .key-cell:hover:not(:disabled) { filter: brightness(1.18); transform: translateY(-1px); }

  /* Live monitor: press depth as a bottom-up translucent fill. `--depth` is a
     0..100 number set per cell by config-app while the monitor runs. */
  .key-cell.is-live::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(var(--depth, 0) * 1%);
    background: rgba(255, 255, 255, 0.5);
    pointer-events: none;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0 2rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .badge {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    color: var(--muted);
  }

  .busy-overlay {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    display: grid;
    place-items: center;
    z-index: 50;
    font-size: 0.95rem;
  }

  /* ---------------------------------------------------- configurator refresh */

  .config-hero {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    padding: 0.5rem 0 2rem;
  }

  .config-hero h1 { letter-spacing: -0.055em; font-size: clamp(2rem, 4vw, 3.25rem); }
  .config-lead { color: var(--muted); margin: 0.5rem 0 0; font-size: 1.02rem; }
  .eyebrow { color: var(--accent); font: 700 0.68rem/1.4 var(--mono); letter-spacing: 0.14em; margin: 0 0 0.5rem; }
  .config-chip { display: inline-flex; align-items: center; gap: 0.5rem; border: 1px solid var(--border); border-radius: 999px; padding: 0.4rem 0.75rem; color: var(--muted); background: var(--panel); white-space: nowrap; font-size: 0.76rem; }
  .config-chip.is-dirty { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 45%, var(--border)); }
  .live-dot { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--ok); box-shadow: 0 0 12px color-mix(in srgb, var(--ok) 55%, transparent); }

  #config-root > .card { padding: clamp(1.1rem, 2.5vw, 2rem); box-shadow: 0 18px 60px rgba(0, 0, 0, 0.12); }
  #config-root h2 { margin-top: 0; font-size: clamp(1.35rem, 2.3vw, 1.8rem); letter-spacing: -0.035em; }
  #config-root h3 { margin: 0; font-size: 1rem; }
  .section-heading, .panel-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .section-heading { margin-bottom: 1.5rem; }
  .section-heading p:not(.eyebrow) { margin: 0.35rem 0 0; }
  .control-bar { display: flex; align-items: center; gap: 0.7rem; padding: 0.85rem 1rem; border: 1px solid var(--border); border-radius: 12px; background: var(--panel-2); }
  .control-bar > label:first-child { margin-right: 0.1rem; }
  .control-bar select { min-width: 9rem; }
  .control-bar .field-row { margin-left: auto; }
  .inline-hint { margin: 0.55rem 0 1.75rem; }
  .actuation-layout { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(250px, 0.85fr); gap: 1rem; align-items: stretch; }
  .keymap-panel, .editor-panel { min-width: 0; border: 1px solid var(--border); border-radius: 14px; padding: 1rem; background: color-mix(in srgb, var(--panel-2) 62%, var(--panel)); }
  .panel-heading { align-items: center; }
  .panel-heading p { margin: 0.2rem 0 0; }
  .keymap-footnote { color: var(--muted); font-size: 0.75rem; line-height: 1.5; margin: 0.75rem 0 0; }
  .selected-key-card { display: flex; align-items: center; gap: 0.8rem; padding: 0.8rem; margin: 1rem 0 1.35rem; border: 1px solid var(--border); border-radius: 12px; background: var(--panel); }
  .selected-key-card > div { display: flex; flex-direction: column; gap: 0.15rem; }
  .selected-key-id { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 9px; background: var(--accent); color: #11170d; font: 700 0.78rem var(--mono); }
  .editor-panel .field { margin-bottom: 1.25rem; }
  .editor-panel .field > label { color: var(--text); font-size: 0.82rem; font-weight: 600; }
  .editor-panel .field-row { gap: 0.5rem; }
  .editor-panel input[type="range"] { flex: 1 1 100%; }
  .actuation-actions { display: flex; justify-content: space-between; gap: 1rem; align-items: center; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border); }
  .save-button { min-width: 13rem; }

  /* ------------------------------------------- live monitor (read-only) */

  .live-bar { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.85rem; }
  .live-bar .live-rate { min-width: 4rem; font: 600 0.78rem var(--mono); color: var(--muted); }
  .live-bar.is-live .live-rate { color: var(--accent); }
  .live-bar.is-live .live-toggle { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); }
  .live-hint { margin-left: auto; text-align: right; }

  .depth-bar { display: flex; flex-direction: column; gap: 0.45rem; margin: 0 0 1.35rem; }
  .depth-track { position: relative; height: 3.4rem; border: 1px solid var(--border); border-radius: 10px; background: color-mix(in srgb, var(--bg) 55%, var(--panel)); overflow: hidden; }
  .depth-fill { position: absolute; left: 0; right: 0; bottom: 0; height: 0; background: color-mix(in srgb, var(--accent) 45%, transparent); }
  .depth-bar.is-pressed .depth-fill { background: color-mix(in srgb, var(--accent) 75%, transparent); }
  .depth-marker { position: absolute; left: 0; right: 0; border-top: 2px dashed; pointer-events: none; }
  .depth-marker.is-on { border-color: var(--warn); }
  .depth-marker.is-off { border-color: var(--ok); }
  .depth-readout { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .depth-value { font: 600 0.82rem var(--mono); }
  .depth-legend { display: flex; gap: 0.75rem; font-size: 0.72rem; color: var(--muted); }
  .depth-legend span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .depth-legend span::before { content: ""; width: 0.8rem; border-top: 2px dashed currentColor; }
  .depth-legend .is-on { color: var(--warn); }
  .depth-legend .is-off { color: var(--ok); }

  .status { margin-top: 0.75rem; }
  .site-footer { margin-top: 2rem; }

  @media (max-width: 780px) {
    .actuation-layout { grid-template-columns: 1fr; }
    .editor-panel { order: -1; }
    .key-grid { padding: 0.55rem; gap: 3px; }
    .key-cell { border-radius: 4px; }
    .config-hero { align-items: flex-start; flex-direction: column; gap: 0.8rem; }
  }

  @media (max-width: 560px) {
    .container { width: min(100% - 1.25rem, 1200px); }
    main { padding-top: 1.5rem; }
    .control-bar { align-items: stretch; }
    .control-bar select { flex: 1; min-width: 0; }
    .control-bar .field-row { margin: 0; width: 100%; }
    .actuation-actions { align-items: stretch; flex-direction: column; }
    .actuation-actions .button-row { display: grid; grid-template-columns: 1fr 1fr; }
    .save-button { width: 100%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .busy-overlay span {
      animation: pulse 1.2s ease-in-out infinite;
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0.45;
    }
  }
</style>
